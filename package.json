{
  "name": "homebridge-linak-desk",
  "displayName": "LINAK Desk",
  "type": "module",
  "version": "0.1.1",
  "description": "Control the height of LINAK sit/stand desks from Apple Home, via the mqtt-linak bridge.",
  "author": "Anders Ljungh <anders@gomi.se>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/gomi-source/homebridge-linak-desk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gomi-source/homebridge-linak-desk.git"
  },
  "bugs": {
    "url": "https://github.com/gomi-source/homebridge-linak-desk/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "linak",
    "desk",
    "standing-desk",
    "sit-stand",
    "mqtt",
    "homekit"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "prepublishOnly": "npm run lint && npm test",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {
    "mqtt": "^5.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@homebridge/hap-nodejs": "^2.2.3",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
